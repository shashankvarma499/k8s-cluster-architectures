# Copy to terraform.tfvars (gitignored) and edit.
#   cp terraform.tfvars.example terraform.tfvars

region       = "us-west-2"
dr_region    = "us-east-1"
cluster_name = "northstar-payments"

# EKS standard support as of 2026-09: 1.34, 1.35, 1.36.
# https://docs.aws.amazon.com/eks/latest/userguide/kubernetes-versions.html
cluster_version = "1.34"

vpc_cidr = "10.64.0.0/16"
az_count = 3

# Production default is one NAT per AZ. Do not set true for a CDE.
single_nat_gateway = false

# Lock this to your office/VPN CIDR before this cluster holds cardholder data.
# Production PCI clusters should also set cluster_endpoint_public_access = false.
cluster_endpoint_public_access       = true
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

system_node_instance_types = ["m6i.large", "m5.large"]
system_node_min_size       = 3
system_node_desired_size   = 3
system_node_max_size       = 4

karpenter_version            = "1.14.1"
cilium_version               = "1.20.1"
metrics_server_chart_version = "3.13.0"

enable_vpc_endpoints            = true
velero_backup_expiration_days   = 90

tags = {
  Environment = "prod"
  ManagedBy   = "terraform"
  Project     = "northstar-payments"
  PCIScope    = "connected-to-cde"
  Owner       = "platform-team"
}
