# Copy to terraform.tfvars (gitignored) and edit.
#   cp terraform.tfvars.example terraform.tfvars

region       = "us-west-2"
cluster_name = "k8s-arch-eks"

# EKS standard support as of 2026-09: 1.34, 1.35, 1.36.
# https://docs.aws.amazon.com/eks/latest/userguide/kubernetes-versions.html
cluster_version = "1.34"

vpc_cidr = "10.42.0.0/16"
az_count = 3

# true  = one NAT (lab / cost). false = one NAT per AZ (production HA).
single_nat_gateway = true

# Lock this to your office/VPN CIDR before this cluster holds real data.
cluster_endpoint_public_access       = true
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

system_node_instance_types = ["m6i.large", "m5.large"]
system_node_min_size       = 2
system_node_desired_size   = 2
system_node_max_size       = 3

karpenter_version            = "1.14.1"
cilium_version               = "1.20.1"
metrics_server_chart_version = "3.13.0"

tags = {
  Environment = "lab"
  ManagedBy   = "terraform"
  Project     = "k8s-cluster-architectures"
  Owner       = "platform-team"
}
